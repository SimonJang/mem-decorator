{
	"name": "mem-decorator",
	"version": "1.0.0",
	"repository": "https://github.com/SimonJang/mem-decorator",
	"description": "Annotation to memoize a function",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"require": "./lib/index.js",
			"default": "./lib/index.js"
		}
	},
	"packageManager": "npm@11.11.0",
	"scripts": {
		"format": "prettier --write \"source/**/*.ts\"",
		"build": "npm run clean && tsc -p tsconfig.json",
		"test": "npm run build && node --import tsx --test source/test/test.ts",
		"clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
		"prepare": "npm run build",
		"prepack": "npm test",
		"deploy": "npm run prepare && npx np"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"annotations",
		"memoization",
		"optimalization"
	],
	"files": [
		"lib"
	],
	"author": {
		"name": "Simon Jang",
		"email": "simon.jang.contact@gmail.com",
		"url": "https://github.com/SimonJang"
	},
	"license": "MIT",
	"dependencies": {
		"mem": "^6.1.1"
	},
	"devDependencies": {
		"prettier": "^3.8.4",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
